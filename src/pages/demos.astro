---
import { demos } from "@/data/demos";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Test pages for media, audio, and codec behavior in the browser.",
	title: "Demos",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Demos</h1>
	<p class="mb-10">Test pages for media, audio, and codec behavior in the browser.</p>
	<ul class="space-y-6" role="list">
		{
			demos.map((demo) => (
				<li>
					<a class="cactus-link text-accent font-semibold" href={demo.href}>
						{demo.title}
					</a>
					<p class="mt-1">{demo.description}</p>
				</li>
			))
		}
	</ul>
</PageLayout>
