---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { demos } from "@/data/demos";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.nav.demos} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.nav.demos}
    pageDesc="Test pages for media, audio, and codec behavior in the browser."
  >
    <ul>
      {
        demos.map(demo => (
          <li class="my-6">
            <a
              href={demo.href}
              class:list={[
                "text-accent inline-block text-lg font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
                "focus-visible:no-underline focus-visible:underline-offset-0",
              ]}
            >
              <h2>{demo.title}</h2>
            </a>
            <p>{demo.description}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
