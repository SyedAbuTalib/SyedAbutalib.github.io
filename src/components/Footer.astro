---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div
      class="my-2 flex flex-wrap items-center justify-center text-center text-xs sm:flex-nowrap sm:text-left sm:text-sm sm:whitespace-nowrap"
    >
      <span>&#169; {currentYear}</span>
      <span class="text-muted-foreground mx-1.5">|</span>
      <span>
        Using <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://astro-paper.pages.dev/"
          target="_blank"
          rel="noopener noreferrer">AstroPaper</a
        >, <span class="hidden md:inline">shamelessly </span>stolen from <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://alprielse.xyz/"
          target="_blank"
          rel="noopener noreferrer">alprielse.xyz</a
        >
      </span>
    </div>
  </div>
</footer>
